# Silero TTS Configuration
SILERO_LANGUAGE=ru
SILERO_MODEL=v5_1_ru
SILERO_SPEAKER=kseniya
SILERO_SAMPLE_RATE=48000
# SILERO_THREADS=4          # CPU threads for synthesis (default: torch decides)
# SILERO_MAX_CHARS=500      # Longest piece of text sent to the model at once
# SILERO_OFFLINE=true       # Use cached models.yml instead of downloading it

# Global SSML Configuration (optional)
# SILERO_PROSODY_RATE=medium
# SILERO_PROSODY_PITCH=medium
# SILERO_BREAK_TIME=1s
# SILERO_BREAK_STRENGTH=medium

# Wyoming Server Configuration
WYOMING_HOST=0.0.0.0
WYOMING_PORT=10200

# Zeroconf discovery (needs network_mode: host)
# WYOMING_ZEROCONF=true
# WYOMING_ZEROCONF_NAME=silero-ru
# WYOMING_ZEROCONF_HOST=192.168.1.10

# Debug Mode
# WYOMING_DEBUG=true
